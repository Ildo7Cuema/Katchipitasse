# --- Produção (Vercel / Capacitor) ---
# Na Vercel: Settings → Environment Variables (só estas VITE_*).
# Depois do deploy, use a URL pública (ex.: https://katchipitasse.vercel.app).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
VITE_APP_URL=https://seu-projecto.vercel.app

# --- Apenas local / CI de seed — NUNCA no Vercel nem no APK ---
# NUNCA coloque SUPABASE_SECRET_KEY / service_role no frontend nem no Git.
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY_LOCAL_ONLY

# Seed de admins (scripts/seed-admins.mjs) — passwords fortes, só no .env local
SEED_SUPERADMIN_EMAIL=produtor@exemplo.ao
SEED_SUPERADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SEED_SUPERADMIN_NAME=Super Admin
SEED_STOREADMIN_EMAIL=dono@exemplo.ao
SEED_STOREADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SEED_STOREADMIN_NAME=Administrador da Loja
